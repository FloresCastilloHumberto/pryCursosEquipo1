<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="#DDDDDD"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgCurso"
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del curso"/>

        <TextView
            android:id="@+id/txtCurso"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:padding="4dp"
            android:text="PROGRAMACIÓN AVANZADA"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"/>

        <TextView
            android:id="@+id/txtDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="5dp"
            android:text="Salón: A-102"
            android:textColor="#333333"
            android:textSize="11sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VER DETALLE"
                android:textSize="8sp"
                android:minHeight="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="6dp"
                app:backgroundTint="#17558E"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="REGISTRARSE"
                android:textSize="8sp"
                android:minHeight="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="6dp"
                app:backgroundTint="#159447"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>